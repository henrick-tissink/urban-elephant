# Urban Elephant — environment variables.
# Copy to .env.local for local dev, or set these in the hosting provider (e.g.
# Vercel → Project → Settings → Environment Variables) for production.

# Canonical site URL — used for metadata, canonicals, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://www.urbanelephant.co.za

# --- Analytics -------------------------------------------------------------
# GA4 Measurement ID (looks like G-XXXXXXXXXX). The live property is already the
# built-in default, so analytics + conversion events work with no config here.
# Only set this to override — e.g. point staging at a separate GA4 property.
NEXT_PUBLIC_GA4_ID=

# Google Search Console verification token (the value from the "HTML tag"
# verification method — just the content string, not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=

# --- Email (enquiry + partner forms, via Resend) ---------------------------
RESEND_API_KEY=
EMAIL_FROM=Urban Elephant <noreply@urbanelephant.co.za>
EMAIL_TO=reservations@urbanelephant.co.za
